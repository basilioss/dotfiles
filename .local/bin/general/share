#!/bin/sh

host="https://0x0.st"
# host="send.vis.ee"
# host="https://uguu.se"
input="$1"
url_shortener="tinyurl.com/api-create.php?url=$input"

if [ -f "$input" ]; then
  curl -s -F "file=@$1" "$host"
elif [ -p /dev/stdin ]; then
  cat | curl -s -F "file=@-" "$host"
elif printf "%s" "$input" | grep --quiet --no-messages "^http.*"; then
  curl -s "$url_shortener"
  echo
else
  printf "%s\n" "Upload a local file: share /path/to/file"
  printf "%s\n" "Upload from standard input: ls | share"
  printf "%s\n" "Shorten url: share 'url'"
fi
